<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/blurred_brown_gradient"
        app:title="Bookshelf"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/chevron_back"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@+id/trim_upper"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@drawable/trim"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewBookshelf"
        android:layout_width="match_parent"
        android:layout_height="745sp"
        android:layout_below="@id/toolbar"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintVertical_bias="0.0" />

    <View
        android:id="@+id/trim_bottom"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@drawable/trim"
        app:layout_constraintTop_toBottomOf="@id/recyclerViewBookshelf"
        tools:layout_editor_absoluteX="0dp" />

    <ImageButton
        android:id="@+id/btn_add_shelf"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/ic_plus"
        android:scaleType="centerCrop"
        android:background="@null"
        android:padding="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.954"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/trim_bottom"
        app:layout_constraintVertical_bias="0.012"/>


</androidx.constraintlayout.widget.ConstraintLayout>