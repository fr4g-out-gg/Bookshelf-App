<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/blurred_brown_gradient"
        app:title="Bookshelf"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/chevron_back"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/trim_upper"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@drawable/trim"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <ImageButton
        android:id="@+id/btn_add_shelf"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_plus"
        android:scaleType="centerCrop"
        android:background="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/trim_bottom"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@drawable/trim"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/btn_add_shelf" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewBookshelf"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/trim_upper"
        app:layout_constraintBottom_toTopOf="@id/trim_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>