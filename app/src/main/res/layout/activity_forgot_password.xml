<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:backgroundTint="@color/background"
        app:titleTextColor="#FFFFFF"
        app:title=" "
        app:navigationIcon="@drawable/chevron_back"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/resetEmailEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="312dp"
        android:hint="Enter your registered email"
        android:inputType="textEmailAddress"
        android:padding="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/hint_grey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_send_reset_link"
        android:layout_width="200dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/white"
        android:text="Send Reset Link"
        android:textColor="@color/background"
        app:cornerRadius="0dp"
        app:layout_constraintEnd_toEndOf="@+id/resetEmailEditText"
        app:layout_constraintStart_toStartOf="@+id/resetEmailEditText"
        app:layout_constraintTop_toBottomOf="@+id/resetEmailEditText"
        app:strokeColor="@color/stroke"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>