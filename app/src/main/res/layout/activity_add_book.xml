<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/blurred_brown_gradient"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:navigationIcon="@drawable/chevron_back"
        app:navigationIconTint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Pridať Knihu">

    </androidx.appcompat.widget.Toolbar>

    <View
        android:id="@+id/toolbar_line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/add_book_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#26FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_line">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nová kniha"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <EditText android:id="@+id/edit_book_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Názov knihy" android:inputType="textCapSentences"
                android:textColor="@color/white" android:textColorHint="@color/hint_grey" />

            <EditText android:id="@+id/edit_book_author"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Autor" android:layout_marginTop="8dp"
                android:textColor="@color/white" android:textColorHint="@color/hint_grey"/>

            <EditText android:id="@+id/edit_book_genre"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Žáner" android:layout_marginTop="8dp"
                android:textColor="@color/white" android:textColorHint="@color/hint_grey"/>

            <EditText android:id="@+id/edit_book_description"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Popis knihy" android:gravity="top"
                android:layout_marginTop="8dp" android:lines="3"
                android:textColor="@color/white" android:textColorHint="@color/hint_grey"/>
            <ImageView
                android:id="@+id/img_book_cover"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="#EEEEEE"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_select_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/white"
                android:text="Vybrať obálku"
                android:layout_gravity="center"
                android:textColor="@color/black" />

            <CheckBox android:id="@+id/check_is_read"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Prečítaná" android:layout_marginTop="12dp"
                android:textColor="@color/white"
                android:buttonTint="@color/white"/>

            <Button android:id="@+id/btn_save_book"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Uložiť do poličky" android:layout_marginTop="20dp"
                android:backgroundTint="@color/white" android:textColor="@color/black"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>